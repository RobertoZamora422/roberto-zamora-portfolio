{
  "name": "roberto-zamora-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "cross-env PORTFOLIO_PREVIEW=1 react-router dev --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "cross-env PORTFOLIO_PREVIEW=0 react-router build",
    "build:prueba": "cross-env PORTFOLIO_PREVIEW=1 react-router build",
    "preview:prueba": "wrangler pages dev .local/prerender/client --ip 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "isbot": "5.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@react-router/node": "8.5.1",
    "@types/node": "24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.160.0"
  }
}
